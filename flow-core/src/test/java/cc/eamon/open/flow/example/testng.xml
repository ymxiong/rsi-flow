<?xml version="1.0" encoding="UTF-8"?>
<suite name="Suite" parallel="false" >
    <test name="Test">
        <groups>
            <run>
                <include name="test"/>
            </run>
        </groups>
        <classes>
            <class name="cc.eamon.open.flow.example.FLOW_EXCLUSIVE_GATEWAY_UPDATE_USER.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_INCLUSIVE_GATEWAY_UPDATE_USER.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_QUERY_BALANCE_BY_ID.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_QUERY_USER_ACCOUNT.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_QUERY_USER_BALANCE.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_STANDARD_QUERY_USER_BALANCE.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_UPDATE_USER.FlowEngineTest"/>
        </classes>
    </test>
    <test name="Test Error">
        <groups>
            <run>
                <include name="error-test"/>
            </run>
        </groups>
        <classes>
            <class name="cc.eamon.open.flow.example.FLOW_CALL_ITSELF.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_NOT_EXIST_COMPLEX_FLOW.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_NOT_EXIST_FLOWCODE.FlowEngineTest"/>
            <class name="cc.eamon.open.flow.example.FLOW_NOT_EXIST_NEST_FLOW.FlowEngineTest"/>
        </classes>
    </test>
    <test name="Test Insufficient Error">
        <groups>
            <run>
                <include name="insufficient-error-test"/>
            </run>
        </groups>
        <classes>
            <class name="cc.eamon.open.flow.example.FLOW_INSUFFICIENT_PARAMETERS.FlowEngineTest"/>
        </classes>
    </test>

</suite>
