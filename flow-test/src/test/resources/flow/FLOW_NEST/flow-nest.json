        { "name": "value", "type": "String" }
      ],
      "results": [
        { "name": "modifyValue", "type": "String" }
      ]
    },
    {
      "id": "FLOW_SINGLE_NODE",
      "type": "flow",
      "name": "添加一个空白格",
      "reference": "FLOW_SINGLE_NODE",
      "params": [
        { "name": "modifyValue", "type": "String" }
      ],
      "results":[
        { "name": "modifyAddValue", "type": "String" }
      ]
    }
  ],
  "routes": [
    { "source":"start", "target": "FLOW_MULTI_NODE" },
    { "source":"FLOW_MULTI_NODE", "target": "FLOW_SINGLE_NODE" },
    { "source":"FLOW_SINGLE_NODE", "target": "end" }
  ]
