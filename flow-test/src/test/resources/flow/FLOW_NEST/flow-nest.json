{
  "id": "FLOW_NEST",
  "type": "flow",
  "name": "简单流程嵌套",
  "params": [
    { "name": "value", "type": "String" }
  ],
  "results": [
    { "name": "modifyAddValue", "type": "String" }
  ],
  "nodes": [
    {
      "id": "FLOW_MULTI_NODE",
      "type": "flow",
      "name": "清除空白格",
