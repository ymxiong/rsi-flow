{
  "id": "FLOW_MULTI_NODE",
  "type": "flow",
  "name": "多节点流程标准",
  "params": [
    { "name": "value" }
  ],
  "results": [
    { "name": "replaceAllBlankValue" }
  ],
  "nodes": [
    {
      "id": "FLOW_SIMPLE_ADD_BLANK",
      "type": "event",
      "name": "添加空白格",
      "reference": "FLOW_SIMPLE_ADD_BLANK",
      "params": [
        { "name": "value", "type": "String" }
      ],
      "result":
        { "name": "addBlankValue", "type": "String" }
    },
    {
      "id": "FLOW_SIMPLE_REPLACE_ALL_BLANK",
      "type": "event",
      "name": "清除空白格",
      "reference": "FLOW_SIMPLE_REPLACE_ALL_BLANK",
      "params": [
        { "name": "addBlankValue", "type": "String" }
      ],
      "result":
      { "name": "replaceAllBlankValue", "type": "String" }
    }
  ],
  "routes": [
    { "source":"start", "target": "FLOW_SIMPLE_ADD_BLANK" },
    { "source":"FLOW_SIMPLE_ADD_BLANK", "target": "FLOW_SIMPLE_REPLACE_ALL_BLANK" },
    { "source":"FLOW_SIMPLE_REPLACE_ALL_BLANK", "target": "end" }
  ]
}